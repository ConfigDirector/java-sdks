# Copy to .env and fill in. .env is gitignored; never commit real keys.
#
#   cd samples/spring-boot && cp .env.example .env

# Your ConfigDirector server SDK key. A secret.
CONFIGDIRECTOR_SERVER_KEY=fake-sample-key

# Only needed when routing through a proxy to reach ConfigDirector.
# CONFIGDIRECTOR_BASE_URL=https://proxy.internal/configdirector

# streaming, polling, or one-time.
CONFIGDIRECTOR_MODE=streaming

# Initialization timeout, as a Spring duration: 3s, 1500ms, 1m.
CONFIGDIRECTOR_TIMEOUT=3s

# Set to DEBUG to watch every evaluation as it happens.
CONFIGDIRECTOR_LOG_LEVEL=INFO
